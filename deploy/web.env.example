# Copy to ~/.config/dwts/web.env on the server (chmod 600). Never commit the real file.
# omniroute runs on the same Docker network (tunnel-net), so the app reaches it directly.
LLM_BASE_URL=http://omniroute:20128/v1
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Optional: embeddings model for hybrid retrieval (leave empty for keyword search only)
EMBED_MODEL=
LLM_MAX_TOKENS=1800
LLM_TEMPERATURE=0.3
# Per-IP limits for /api/chat
CHAT_RATE_PER_MIN=8
CHAT_RATE_PER_DAY=150
