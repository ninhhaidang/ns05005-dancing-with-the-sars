---
// Old URL: the map now lives on the landing page. Keep links like /map/?view=change working.
const target = '/';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={target} />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
	</head>
	<body><a href={target}>Open the map</a></body>
</html>
