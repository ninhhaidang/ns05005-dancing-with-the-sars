---
import Default from '@astrojs/starlight/components/Footer.astro';
import Chat from './chat/Chat.tsx';
const vi = Astro.currentLocale === 'vi';
const onChatPage = /\/chat\/?$/.test(Astro.url.pathname);
---
<Default><slot /></Default>
<p class="dwts-credit">
	{vi
		? 'Bài thi NISAR L-band Change Detection and Land Cover Mapping (Phát hiện biến động và phân loại lớp phủ bằng ảnh NISAR băng L) · Đội 2936-ThanhNoi (NS05005) · NASA Space Apps Challenge 2026, đề bài Dancing with the SARs · Dữ liệu NISAR GCOV (VALIDATED, P05036) từ ASF DAAC.'
		: 'Entry: NISAR L-band Change Detection and Land Cover Mapping · Team 2936-ThanhNoi (NS05005) · NASA Space Apps Challenge 2026, challenge Dancing with the SARs · NISAR GCOV data (VALIDATED, P05036) from ASF DAAC.'}
</p>
{!onChatPage && <Chat client:idle lang={vi ? 'vi' : 'en'} mode="widget" />}
<style>
	.dwts-credit { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); margin-top: 1rem; }
</style>
